---
import Landing from "../layouts/Landing.astro"

const install = "bun install -g abstract-cli"

// The demo uses real papers and VERBATIM quotes (checked against the arXiv
// abstracts) — a page about not inventing citations must not invent any.
const demo = [
  {
    id: "s1",
    verdict: "supported",
    text: "The Transformer replaced recurrence and convolution with attention alone",
    cite: 1,
    quote:
      "We propose a new simple network architecture, the Transformer, based solely on attention mechanisms, dispensing with recurrence and convolutions entirely.",
    source: "Vaswani et al. — Attention Is All You Need (2017)",
    meta: "arXiv:1706.03762 · p. 1 · preprint",
    note: "Every part of the claim follows from the passage, so the sentence is marked supported.",
  },
  {
    id: "s2",
    verdict: "partial",
    text: "Residual networks are easier to optimize and always more accurate at greater depth",
    cite: 2,
    quote:
      "these residual networks are easier to optimize, and can gain accuracy from considerably increased depth.",
    source: "He et al. — Deep Residual Learning for Image Recognition (2015)",
    meta: "arXiv:1512.03385 · p. 1 · preprint",
    note: "“Always more accurate” is stronger than the source’s “can gain accuracy”, so the sentence is only partly supported.",
  },
  {
    id: "s3",
    verdict: "unsupported",
    text: "Residual connections were first introduced for machine translation",
    cite: 2,
    quote: "",
    source: "He et al. — Deep Residual Learning for Image Recognition (2015)",
    meta: "arXiv:1512.03385",
    note: "No passage in the cited source supports this claim. Export stops until you fix it or explicitly accept it.",
  },
]

const features = [
  ["discovery", "Literature search", "Searches OpenAlex, Crossref, and arXiv at once, deduplicated, and follows citation chains backward and forward."],
  ["discovery", "Screening log", "Every search and include/exclude decision is recorded with its reason, and exports as a PRISMA-style flow."],
  ["reading", "Reads before it cites", "Only sources the agent actually opened can be cited — downloading a paper is not reading it."],
  ["reading", "Scanned PDFs and figures", "Image-only PDFs are transcribed by your model; figures, tables, and equations become searchable."],
  ["writing", "Verified tables", "Comparison tables and extraction matrices are checked cell by cell, exactly like sentences."],
  ["writing", "Numeric or author–year", "Citations as [1] or (Hooker et al., 2020), with bibliographies built only from registry records."],
  ["scale", "Parallel readers", "For big reading lists the agent hands work to up to four sub-agents, under the same integrity rules."],
  ["craft", "38 built-in skills", "Venue review rubrics (NeurIPS, ACL, CVPR, IEEE, Nature…), methods checklists, and writing guides — and you can add your own."],
  ["control", "Steer while it works", "A visible plan, messages the agent reads at its next step, and a stop button that actually stops."],
  ["memory", "Memory you control", "What you ask it to remember is saved right away; preferences it only infers wait for your approval."],
  ["analysis", "Runs your analysis", "Executes Python scripts on your data in the workspace, without access to your API keys."],
  ["integrity", "Reference check", "Checks every DOI in a manuscript for resolution and retraction before you submit."],
]
---

<Landing
  title="abstract — research with an agent, every citation verified"
  description="A free, open-source research workbench. An AI agent searches, reads, and drafts with you — and won't write a citation it can't trace to a real source."
>
  <style>
    .hero { text-align: center; padding-top: 56px; padding-bottom: 30px; }
    .hero canvas { max-width: min(520px, 90vw); height: auto; display: block; margin: 0 auto; color: var(--ink); }
    .hero h1 { font-size: clamp(34px, 5.6vw, 58px); margin-top: 6px; }
    .hero .sub { max-width: 640px; margin: 18px auto 0; font-size: 18px; color: var(--muted); }
    .hero .sub b { color: var(--ink); font-weight: 600; }
    .cta { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 28px; }
    .install {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      max-width: 460px; margin: 26px auto 0; background: var(--code-bg); color: var(--code-ink);
      font-family: var(--mono); font-size: 14px; padding: 12px 14px 12px 18px;
    }
    .install .p { opacity: 0.5; margin-right: 8px; }
    .install button {
      font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
      background: transparent; color: var(--code-ink); border: 1px solid color-mix(in srgb, var(--code-ink) 30%, transparent);
      padding: 4px 9px; cursor: pointer;
    }
    .install button:hover { border-color: var(--code-ink); }
    .fine { margin-top: 12px; font-size: 13px; color: var(--muted); }

    section.block { padding-top: 96px; }
    .head { max-width: 660px; }
    .head h2 { font-size: clamp(26px, 3.4vw, 36px); margin-top: 8px; }
    .head p { margin-top: 12px; color: var(--muted); font-size: 17px; }

    /* integrity demo */
    .demo { display: grid; grid-template-columns: 1.15fr 1fr; border: 1px solid var(--line); background: var(--surface); margin-top: 34px; }
    .demo .doc { padding: 26px 28px; border-right: 1px solid var(--line); }
    .demo .doc .bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
    .demo .doc h3 { font-size: 21px; margin-bottom: 12px; }
    .demo .doc p.body { font-family: var(--serif); font-size: 18px; line-height: 1.75; }
    .s { cursor: pointer; padding: 1px 0; border-bottom: 2px solid transparent; outline: none; }
    .s[data-v="supported"] { background: color-mix(in srgb, var(--ok) 13%, transparent); border-color: var(--ok); }
    .s[data-v="partial"] { background: color-mix(in srgb, var(--warn) 15%, transparent); border-color: var(--warn); }
    .s[data-v="unsupported"] { background: color-mix(in srgb, var(--bad) 14%, transparent); border-color: var(--bad); }
    .s.on[data-v="supported"] { background: color-mix(in srgb, var(--ok) 30%, transparent); }
    .s.on[data-v="partial"] { background: color-mix(in srgb, var(--warn) 32%, transparent); }
    .s.on[data-v="unsupported"] { background: color-mix(in srgb, var(--bad) 28%, transparent); }
    .s:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .s sup { font-family: var(--mono); font-size: 11px; color: var(--accent); margin-left: 1px; }
    .tally { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 18px; font-family: var(--mono); font-size: 11.5px; color: var(--muted); }
    .chip { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; padding: 2px 7px; border: 1px solid currentColor; white-space: nowrap; }
    .chip.supported { color: var(--ok); }
    .chip.partial { color: var(--warn); }
    .chip.unsupported { color: var(--bad); }
    .demo .ev { padding: 26px 28px; background: var(--paper); }
    .ev .quote { font-family: var(--serif); font-size: 17px; line-height: 1.6; margin-top: 14px; padding-left: 14px; border-left: 2px solid var(--line); }
    .ev .quote mark { background: color-mix(in srgb, var(--ok) 18%, transparent); color: inherit; }
    .ev .src { margin-top: 14px; font-size: 14px; }
    .ev .meta { font-family: var(--mono); font-size: 11.5px; color: var(--muted); margin-top: 3px; }
    .ev .note { margin-top: 14px; font-size: 14.5px; color: var(--muted); }
    .ev .none { margin-top: 14px; font-size: 15px; color: var(--bad); }
    .rules { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--line); border-top: 0; }
    .rules div { padding: 20px 22px; border-right: 1px solid var(--line); background: var(--surface); }
    .rules div:last-child { border-right: 0; }
    .rules b { display: block; font-size: 15px; margin: 6px 0 4px; }
    .rules p { font-size: 14px; color: var(--muted); }

    /* how it works */
    .steps { display: grid; grid-template-columns: repeat(5, 1fr); border: 1px solid var(--line); margin-top: 34px; }
    .step { padding: 20px 18px 22px; border-right: 1px solid var(--line); background: var(--surface); }
    .step:last-child { border-right: 0; }
    .step .n { font-family: var(--mono); font-size: 11px; color: var(--accent); }
    .step b { display: block; font-size: 16px; margin: 6px 0 6px; }
    .step p { font-size: 14px; color: var(--muted); }
    .ask { margin-top: 18px; font-family: var(--mono); font-size: 13px; color: var(--muted); }
    .ask span { color: var(--ink); }

    /* features */
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: 34px; border-left: 1px solid var(--line); border-top: 1px solid var(--line); }
    .feat { padding: 22px 22px 24px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--surface); }
    .feat b { display: block; font-size: 16px; margin: 6px 0 5px; }
    .feat p { font-size: 14px; color: var(--muted); }

    /* models */
    .models { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 34px; }
    .model { border: 1px solid var(--line); background: var(--surface); padding: 24px; }
    .model h3 { font-size: 20px; margin: 8px 0 8px; }
    .model p { font-size: 14.5px; color: var(--muted); }
    .model ul { margin: 12px 0 0; padding-left: 18px; font-size: 14px; color: var(--muted); }
    .note-line { margin-top: 18px; font-size: 14.5px; color: var(--muted); max-width: 760px; }

    /* privacy + open source */
    .split { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid var(--line); margin-top: 34px; }
    .split > div { padding: 26px 28px; background: var(--surface); }
    .split > div + div { border-left: 1px solid var(--line); }
    .split h3 { font-size: 19px; margin: 8px 0 10px; }
    .split ul { margin: 0; padding-left: 18px; font-size: 14.5px; color: var(--muted); }
    .split li { margin: 5px 0; }
    .split a { color: var(--accent); }

    .final { text-align: center; padding-top: 110px; }
    .final h2 { font-size: clamp(28px, 4vw, 42px); }
    .final p { color: var(--muted); margin-top: 10px; font-size: 17px; }

    @media (max-width: 900px) {
      .demo { grid-template-columns: 1fr; }
      .demo .doc { border-right: 0; border-bottom: 1px solid var(--line); }
      .rules, .models, .split { grid-template-columns: 1fr; }
      .rules div { border-right: 0; border-bottom: 1px solid var(--line); }
      .rules div:last-child { border-bottom: 0; }
      .split > div + div { border-left: 0; border-top: 1px solid var(--line); }
      .steps { grid-template-columns: 1fr 1fr; }
      .step { border-bottom: 1px solid var(--line); }
      .grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 560px) {
      .steps, .grid { grid-template-columns: 1fr; }
      .step { border-right: 0; }
      .hero .sub { font-size: 16.5px; }
    }
  </style>

  <!-- ============ HERO ============ -->
  <header class="hero wrap">
    <canvas id="mark" width="680" height="340" aria-label="abstract — wordmark assembling from polygons"></canvas>
    <h1>Research with an agent.<br />Every citation verified.</h1>
    <p class="sub">
      abstract searches the literature, reads your papers, and drafts with you — and{" "}
      <b>every cited sentence is checked against the passage it cites</b>. Free, open source,
      and it runs on your own computer.
    </p>
    <div class="install" role="group" aria-label="install command">
      <span><span class="p">$</span>{install}</span>
      <button type="button" data-copy={install}>copy</button>
    </div>
    <p class="fine">or <code>npm i -g abstract-cli</code> · needs <a href="https://bun.sh">Bun</a> · macOS and Linux</p>
    <div class="cta">
      <a class="btn" href="/docs/quick-start/">Get started</a>
      <a class="btn ghost" href="/docs/">Read the docs</a>
    </div>
  </header>

  <!-- ============ INTEGRITY ============ -->
  <section class="block wrap" id="integrity">
    <div class="head reveal">
      <span class="label">integrity in code, not in a prompt</span>
      <h2>Sentences that carry their evidence</h2>
      <p>
        Most AI writing tools ask the model to be careful. abstract checks the model's work with code.
        Point at a sentence to see what backs it up.
      </p>
    </div>

    <div class="demo reveal">
      <div class="doc">
        <div class="bar">
          <span class="label">verified draft · related-work</span>
          <span class="label">illustration</span>
        </div>
        <h3>Related work</h3>
        <p class="body">
          {demo.map((d) => (
            <>
              <span class="s" tabindex="0" role="button" data-id={d.id} data-v={d.verdict} aria-label={`${d.verdict}: ${d.text}`}>
                {d.text}<sup>[{d.cite}]</sup>.
              </span>{" "}
            </>
          ))}
        </p>
        <div class="tally">
          <span><span class="chip supported">supported</span> 1</span>
          <span><span class="chip partial">partial</span> 1</span>
          <span><span class="chip unsupported">unsupported</span> 1</span>
        </div>
      </div>
      <div class="ev" aria-live="polite">
        {demo.map((d, i) => (
          <div data-ev={d.id} hidden={i !== 0}>
            <span class={`chip ${d.verdict}`}>{d.verdict}</span>
            {d.quote ? (
              <>
                <p class="label" style="margin-top: 16px;">verbatim from the source</p>
                <p class="quote"><mark>{d.quote}</mark></p>
              </>
            ) : (
              <p class="none">No supporting passage found.</p>
            )}
            <p class="src">{d.source}</p>
            <p class="meta">{d.meta}</p>
            <p class="note">{d.note}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="rules reveal">
      <div>
        <span class="label">metadata</span>
        <b>Never written by a model</b>
        <p>Titles, authors, venues, and DOIs are copied from Crossref and OpenAlex records.</p>
      </div>
      <div>
        <span class="label">verification</span>
        <b>A quote, or it isn't “supported”</b>
        <p>A sentence is only marked supported if the checker quotes the source word for word — and code confirms the quote is really there.</p>
      </div>
      <div>
        <span class="label">export</span>
        <b>Gated at the door</b>
        <p>Export re-checks every DOI for resolution and retraction, and stops on unsupported claims unless you accept them.</p>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="block wrap" id="how">
    <div class="head reveal">
      <span class="label">how it works</span>
      <h2>From a question to a verified document</h2>
      <p>One agent plans the work, shows you its plan, and keeps going until it's done — you can steer it at any point.</p>
    </div>
    <div class="steps reveal">
      <div class="step"><span class="n">01</span><b>Ask</b><p>In plain words, in a chat. Point it at a folder of your own papers, or start from nothing.</p></div>
      <div class="step"><span class="n">02</span><b>Search</b><p>It searches OpenAlex, Crossref, and arXiv, follows citations, and logs every include and exclude decision.</p></div>
      <div class="step"><span class="n">03</span><b>Read</b><p>It fetches open-access PDFs, reads them page by page, and keeps notes. Only what it opened can be cited.</p></div>
      <div class="step"><span class="n">04</span><b>Write & verify</b><p>It drafts in Markdown and checks every cited sentence and table cell against the passage it cites.</p></div>
      <div class="step"><span class="n">05</span><b>Export</b><p>Markdown, LaTeX, and BibTeX — plus an audit file that maps every claim to its evidence.</p></div>
    </div>
    <p class="ask reveal">try: <span>“Do a literature review on frugal AI benchmarks and write a related-work section.”</span></p>
  </section>

  <!-- ============ FEATURES ============ -->
  <section class="block wrap" id="features">
    <div class="head reveal">
      <span class="label">what's inside</span>
      <h2>Built for the whole research workflow</h2>
    </div>
    <div class="grid">
      {features.map(([k, t, p], i) => (
        <div class="feat reveal" style={`--d: ${(i % 3) * 0.05}s;`}>
          <span class="label">{k}</span>
          <b>{t}</b>
          <p>{p}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ MODELS ============ -->
  <section class="block wrap" id="models">
    <div class="head reveal">
      <span class="label">models</span>
      <h2>Bring the model you already have</h2>
      <p>Pick one model in the chat box and abstract uses it for everything. The list shows only recent models from what you've connected.</p>
    </div>
    <div class="models reveal">
      <div class="model">
        <span class="label">no api key</span>
        <h3>Your ChatGPT plan</h3>
        <p>Click <b>Continue with ChatGPT</b> and abstract runs on your Plus or Pro plan. Set a usage cap any time in ChatGPT settings.</p>
      </div>
      <div class="model">
        <span class="label">api keys</span>
        <h3>Your own keys</h3>
        <p>Paste a key in Settings or use an environment variable.</p>
        <ul><li>Anthropic</li><li>OpenAI</li><li>Google</li><li>OpenRouter</li></ul>
      </div>
      <div class="model">
        <span class="label">fully local</span>
        <h3>Ollama</h3>
        <p>Run open models on your own machine, so document content never goes to a cloud provider.</p>
      </div>
    </div>
    <p class="note-line reveal">
      Semantic library search uses embeddings from OpenAI, Google, or Ollama when one is connected;
      otherwise abstract searches by keyword.
    </p>
  </section>

  <!-- ============ PRIVACY + OPEN SOURCE ============ -->
  <section class="block wrap" id="privacy">
    <div class="head reveal">
      <span class="label">your data</span>
      <h2>Local-first, and honest about it</h2>
    </div>
    <div class="split reveal">
      <div>
        <span class="label">stays on your machine</span>
        <h3>Stored locally</h3>
        <ul>
          <li>Your papers, notes, drafts, and conversations live in your workspace folder.</li>
          <li>Settings and keys live in <code>~/.abstract</code>. No account, no server of ours.</li>
          <li>The app only listens on your own computer (127.0.0.1).</li>
        </ul>
      </div>
      <div>
        <span class="label">leaves your machine</span>
        <h3>Only what the work needs</h3>
        <ul>
          <li>Messages, passages, and the files it reads go to the model provider you chose.</li>
          <li>Searches and DOI checks go to OpenAlex, Crossref, arXiv, Unpaywall, and doi.org; papers it fetches download from their publishers.</li>
          <li>Details in the <a href="/docs/privacy/">privacy guide</a>.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="final wrap reveal">
    <span class="label">free and open source · apache-2.0</span>
    <h2 style="margin-top: 10px;">Your next review, with receipts.</h2>
    <p>Install in one line. No account, no subscription.</p>
    <div class="install" role="group" aria-label="install command">
      <span><span class="p">$</span>{install}</span>
      <button type="button" data-copy={install}>copy</button>
    </div>
    <div class="cta">
      <a class="btn" href="/docs/quick-start/">Get started</a>
      <a class="btn ghost" href="https://github.com/rabieHs/abstract">View on GitHub</a>
    </div>
  </section>

  <script is:inline src="/wordmark.js"></script>
  <script is:inline>
    // integrity demo: point at (hover, focus, or tap) a sentence to see its evidence
    ;(() => {
      const sents = document.querySelectorAll(".s[data-id]")
      const show = (id) => {
        sents.forEach((s) => s.classList.toggle("on", s.dataset.id === id))
        document.querySelectorAll("[data-ev]").forEach((p) => (p.hidden = p.dataset.ev !== id))
      }
      sents.forEach((s) => {
        s.addEventListener("mouseenter", () => show(s.dataset.id))
        s.addEventListener("focus", () => show(s.dataset.id))
        s.addEventListener("click", () => show(s.dataset.id))
        s.addEventListener("keydown", (e) => (e.key === "Enter" || e.key === " ") && (e.preventDefault(), show(s.dataset.id)))
      })
      show("s1")
    })()
  </script>
</Landing>
